{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Malaysia Government Open Data Knowledge Base record",
  "type": "object",
  "required": [
    "knowledge_base_version",
    "record_kind",
    "id",
    "title",
    "description",
    "api",
    "temporal",
    "fields",
    "license",
    "official_pages",
    "provenance"
  ],
  "properties": {
    "knowledge_base_version": {
      "type": "string"
    },
    "record_kind": {
      "enum": [
        "catalogue_dataset",
        "realtime_api_resource"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "object",
      "required": [
        "en",
        "ms"
      ]
    },
    "description": {
      "type": "object",
      "required": [
        "en",
        "ms"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "logical_type_official",
          "sql_type_suggested",
          "sql_type_basis"
        ]
      }
    },
    "official_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
